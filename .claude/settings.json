{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(dir:*)",
      "Bash(gh:*)",
      "Bash(find:*)",
      "WebSearch"
    ],
    "deny": [
      "Edit(Librerias_LPC/**)",
      "Edit(Referencias/**)",
      "Edit(CMSIS_Driver_templates/**)",
      "Edit(docs_plantilla/**)"
    ]
  },
  "model": "haiku",
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  }
  "outputStyle": "respuesta-corta",
  "plansDirectory": ".claude/plans"
}

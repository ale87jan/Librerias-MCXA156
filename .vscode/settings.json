{
  "claudeCode.preferredLocation": "sidebar",
  
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.fontFamily": "'Fira Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": "'ss02', 'ss03', 'ss04', 'ss05', 'ss07', 'cv30', 'cv30', 'onum'",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "editor.formatOnType": true,
  "editor.wordWrapColumn": 100,
  "editor.wordWrap": "wordWrapColumn",
  "editor.tabSize": 2,
  "editor.rulers": [100],
  "editor.autoIndentOnPaste": true,
  "editor.minimap.maxColumn": 100,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "boundary",
  
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  
  "yaml.format.printWidth": 100,
  "yaml.schemas": {
    "https://squidfunk.github.io/mkdocs-material/schema.json": "mkdocs.yml",
    "https://www.schemastore.org/clangd.json": ".clangd"
  },
  "yaml.customTags": [
    "!ENV scalar",
    "!ENV sequence",
    "!relative scalar",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.to_svg",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.twemoji",
    "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format",
    "tag:yaml.org,2002:python/object/apply:pymdownx.slugs.slugify mapping"
  ],
  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "files.associations": {
    "MCXA156.h": "c",
    "system_MCXA156.h": "c"
  },
  
  "github.copilot.nextEditSuggestions.enabled": true,
  
  "cSpell.enabled": false,
  
  "C_Cpp.doxygen.generatedStyle": "/**",
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 2, ColumnLimit: 100 }",
  "C_Cpp.clang_format_style": ".clang-format",
  "C_Cpp.default.intelliSenseMode": "clang-arm",
  "C_Cpp.intelliSenseEngine": "disabled",
  
  "clangd.fallbackFlags": [
    "-DCPU_MCXA156VLL",
    "-DMCXA156_SERIES",
    "-D_RTE_",
    "-xc",
    "-std=gnu11",
    "--target=arm-none-eabi",
    "-mcpu=cortex-m33",
    "-mfpu=fpv5-sp-d16",
    "-mfloat-abi=hard",
    "-IC:/Users/ale87/AppData/Local/Keil_v5/ARM/ARMCLANG/include",
    "-IC:/Users/ale87/AppData/Local/Arm/Packs/NXP/MCXA156_DFP/25.12.00/devices/MCXA156",
    "-IC:/Users/ale87/AppData/Local/Arm/Packs/NXP/MCXA156_DFP/25.12.00/devices/MCXA156/drivers",
    "-IC:/Users/ale87/AppData/Local/Arm/Packs/ARM/CMSIS/6.3.0/CMSIS/Core/Include"
  ],
  
  "workbench.startupEditor": "none",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.iconTheme": "symbols",
  
  "editor.unicodeHighlight.includeComments": true,
  "editor.unicodeHighlight.nonBasicASCII": true,
  "editor.unicodeHighlight.allowedCharacters": {
    "á": true,
    "é": true,
    "í": true,
    "ó": true,
    "ú": true,
    "Á": true,
    "É": true,
    "Í": true,
    "Ó": true,
    "Ú": true,
    "ñ": true,
    "Ñ": true,
    "ü": true,
    "Ü": true,
    "¿": true,
    "¡": true,
    "°": true,
    "·": true
  }
}
